              "id": "CWE-79",
              "name": "Reflected XSS in User Rendered Content",
              "shortDescription": {
                "text": "Reflected XSS in User Rendered Content"
              },
              "fullDescription": {
                "text": "Instances of unescaped user-generated content were found in `innerHTML` assignments resulting in potential XSS vulnerabilities."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Instances of unescaped user-generated content were found in `innerHTML` assignments resulting in potential XSS vulnerabilities.\n\nAn attacker can execute arbitrary JavaScript in the context of the user's session, which could lead to data theft, credential compromise, or malware distribution.\n\nImplement proper output encoding and sanitization for all user-generated content. Utilize libraries like DOMPurify to prevent script injections. Ensure proper Content Security Policy (CSP) is enforced to mitigate XSS attempts.",
                "markdown": "Instances of unescaped user-generated content were found in `innerHTML` assignments resulting in potential XSS vulnerabilities.\n\nAn attacker can execute arbitrary JavaScript in the context of the user's session, which could lead to data theft, credential compromise, or malware distribution.\n\nImplement proper output encoding and sanitization for all user-generated content. Utilize libraries like DOMPurify to prevent script injections. Ensure proper Content Security Policy (CSP) is enforced to mitigate XSS attempts."
              },
              "properties": {
                "security-severity": "8.1",
                "tags": [
                  "security",
                  "CWE-79",
                  "stride:T",
                  "stride:I"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html"
            }
          ],
          "version": "1.5.3"
        }
      },
